<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Current Site Indicator -->
            <TextView
                android:id="@+id/textCurrentSite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_site_indicator"
                android:padding="12dp"
                android:textColor="@color/primary_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="📍 Sample Site Name" />

            <!-- Site Selection Spinner -->
            <com.google.android.material.card.MaterialCardView
                style="@style/NammaMistri.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_site"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinnerSite"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_spinner"
                        android:padding="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Wall Thickness Selection -->
            <com.google.android.material.card.MaterialCardView
                style="@style/NammaMistri.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wall_thickness"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinnerThickness"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_spinner"
                        android:padding="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Dimensions Input Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/NammaMistri.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📐 ಗೋಡೆ ಅಳತೆ / Wall Dimensions"
                        style="@style/NammaMistri.SubHeader"
                        android:layout_marginBottom="16dp" />

                    <!-- Length Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/NammaMistri.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/length_meters">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputLength"
                            style="@style/NammaMistri.TextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:inputType="numberDecimal"
                            android:textSize="18sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Width Input (Optional) -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/NammaMistri.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/width_meters"
                        app:helperText="(ಐಚ್ಛಿಕ / Optional)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputWidth"
                            style="@style/NammaMistri.TextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:inputType="numberDecimal"
                            android:textSize="18sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Height Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/NammaMistri.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/height_meters">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputHeight"
                            style="@style/NammaMistri.TextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:inputType="numberDecimal"
                            android:textSize="18sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Calculate Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCalculate"
                style="@style/NammaMistri.Button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:text="@string/calculate"
                android:textAllCaps="true"
                app:icon="@drawable/ic_calculate"
                app:iconGravity="start" />

            <!-- Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                style="@style/NammaMistri.CardView.Result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_title"
                        style="@style/NammaMistri.Header"
                        android:textColor="@color/primary_dark"
                        android:layout_marginBottom="16dp" />

                    <!-- Materials Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <!-- Bricks -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="@drawable/bg_result_item">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🧱"
                                android:textSize="32sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/bricks_required"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/textBricksValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                tools:text="1,250 nos" />

                        </LinearLayout>

                        <View
                            android:layout_width="8dp"
                            android:layout_height="1dp" />

                        <!-- Cement -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="@drawable/bg_result_item">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏗️"
                                android:textSize="32sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cement_bags"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/textCementValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                tools:text="12 bags" />

                        </LinearLayout>

                        <View
                            android:layout_width="8dp"
                            android:layout_height="1dp" />

                        <!-- Sand -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="@drawable/bg_result_item">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏖️"
                                android:textSize="32sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sand_loads"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/textSandValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                tools:text="0.72 loads" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/one_load_info"
                        android:textSize="10sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginBottom="12dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="12dp" />

                    <!-- Cost Breakdown -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/estimated_cost"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/textCostBreakdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp"
                        tools:text="🧱 Bricks: ₹10,625\n🏗️ Cement: ₹4,560\n🏖️ Sand: ₹3,960" />

                    <!-- Total Cost -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_total_cost"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💰 ಒಟ್ಟು / TOTAL"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_on_primary" />

                        <TextView
                            android:id="@+id/textTotalCost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_on_primary"
                            tools:text="₹19,145" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSave"
                    style="@style/NammaMistri.Button"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="2"
                    android:layout_marginEnd="8dp"
                    android:text="@string/save_to_log"
                    app:icon="@android:drawable/ic_menu_save"
                    app:iconGravity="start" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonClear"
                    style="@style/NammaMistri.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="@string/clear"
                    android:textColor="@color/primary" />

            </LinearLayout>

            <!-- Calculation History Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calculation_history"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/textNoHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/no_calculations"
                android:textColor="@color/text_hint"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_material_log"
                tools:itemCount="3" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
