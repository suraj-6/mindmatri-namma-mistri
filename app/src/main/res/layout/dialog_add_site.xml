<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Site Name -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/NammaMistri.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="ಸೈಟ್ ಹೆಸರು / Site Name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputSiteName"
            style="@style/NammaMistri.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:inputType="textCapWords"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Location -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/NammaMistri.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="ಸ್ಥಳ / Location">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputLocation"
            style="@style/NammaMistri.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:inputType="textCapWords"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Start Date -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/input_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ಆರಂಭ ದಿನಾಂಕ / Start Date"
                android:textSize="16sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/textSelectedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:padding="8dp"
                tools:text="15 Jan 2024" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
